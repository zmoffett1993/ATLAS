{
  "id": "./",
  "name": "ATLAS Warehouse SKU Finder",
  "short_name": "ATLAS",
  "description": "Find warehouse SKUs, browse aisle locations, and manage inventory.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "portrait-primary",
